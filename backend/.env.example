# Database (Neon in prod; docker-compose locally)
DATABASE_URL=jdbc:postgresql://localhost:5432/studyloop
DATABASE_USER=studyloop
DATABASE_PASSWORD=studyloop

# Auth — JWT_SECRET must be >= 32 bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Gemini — if GEMINI_API_KEY is blank the app runs with deterministic Fake clients (dev/test only)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# Similarity calibration (cosine similarity, 0..1) — tune in P4 (see docs/ARCHITECTURE.md)
SIM_DUPLICATE_THRESHOLD=0.80
SIM_GROUNDING_THRESHOLD=0.65
SIM_SEMANTIC_FLOOR=0.50
SIM_SEMANTIC_CEIL=0.90

# Demo
DEMO_MODE=true
SEED_DEMO=true
ADMIN_TOKEN=

# Web
ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
